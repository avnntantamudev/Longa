# =============================================================================
# BISCA — variáveis de ambiente
# Copie para .env e preencha. NUNCA faça commit do .env nem de segredos reais.
# Os valores abaixo servem o ambiente Docker (docker compose up).
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME=BISCA
APP_ENV=local
# Gerado com: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Angola: UTC+1, sem horário de verão
APP_TIMEZONE=Africa/Luanda
# Em Docker a app fica em http://localhost:8080 (ou https://longa.test com mkcert, ver docs/pwa-https.md)
APP_URL=http://localhost:8080

# Idioma da interface e das mensagens da API
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Regras de negócio do BISCA (config/longa.php) ------------------------------
# Moeda: Kwanza, sempre em valores inteiros (sem cêntimos)
LONGA_CURRENCY_CODE=AOA
LONGA_CURRENCY_SYMBOL=Kz
# Indicativo telefónico por defeito (telefones guardados em E.164)
LONGA_PHONE_COUNTRY_CODE=244

# --- OTP (login por código SMS) ----------------------------------------------
OTP_LENGTH=6
# Validade do código em segundos (5 minutos)
OTP_TTL=300
# Tentativas erradas permitidas por código antes de o invalidar
OTP_MAX_ATTEMPTS=5
# Bloqueio temporário do telefone após exceder tentativas (minutos)
OTP_LOCKOUT_MINUTES=15
# Intervalo mínimo entre envios para o mesmo telefone (segundos)
OTP_RESEND_COOLDOWN=60
# Limites de pedidos de código por hora
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# --- Pedidos de aula e matching TRIM TRIM (Fase 2) ---------------------------
LONGA_COMMISSION_PERCENT=15
LONGA_REQUEST_MIN_AMOUNT=2000
LONGA_REQUEST_MAX_ACTIVE=2
# Tempo total de procura (s) e prazo de cada oferta (s)
LONGA_REQUEST_TTL=300
LONGA_OFFER_TTL=60
LONGA_MATCHING_RADIUS_M=5000
LONGA_MATCHING_FIRST_WAVE=10
LONGA_MATCHING_NEXT_WAVE=15
LONGA_MATCHING_WEIGHT_SCORE=0.6
LONGA_MATCHING_WEIGHT_DISTANCE=0.4

# --- SMS ---------------------------------------------------------------------
# "log" escreve as mensagens em storage/logs (desenvolvimento). O provedor real será adicionado depois.
SMS_DRIVER=log
SMS_SENDER_ID=BISCA
# Credenciais do provedor real (por definir)
SMS_API_URL=
SMS_API_KEY=

# --- WhatsApp (WhatsApp Cloud API da Meta) -----------------------------------
# "log" escreve em storage/logs (desenvolvimento); "cloud" usa a API da Meta.
# Requer conta Meta Business verificada, número dedicado e um modelo "Authentication" aprovado.
# As mensagens iniciadas pela empresa são pagas pela Meta por mensagem entregue.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE=longa_codigo_acesso
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT

# --- Logging -----------------------------------------------------------------
# "stack" -> canais em LOG_STACK. "json" escreve uma linha JSON por evento (produção / agregadores).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Base de dados (MySQL 8) -------------------------------------------------
DB_CONNECTION=mysql
# Em Docker: "mysql". Fora de Docker (ex.: Laragon): 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=longa
DB_USERNAME=longa
# Defina uma palavra-passe local; é usada pelo contentor MySQL na primeira inicialização
DB_PASSWORD=
# Só usado pelo contentor MySQL
DB_ROOT_PASSWORD=

# --- Sessão (web / Sanctum SPA) ----------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true em produção (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Domínios que recebem cookies de sessão stateful do Sanctum (SPA/PWA)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:8080,localhost:5173,127.0.0.1,127.0.0.1:8000,longa.test
# Duração dos tokens da API (Flutter) em minutos
SANCTUM_TOKEN_EXPIRATION=60
# Duração do token de refresh em minutos (30 dias); é rodado em cada utilização
SANCTUM_REFRESH_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=longa_

# --- Filas, cache, broadcasting ----------------------------------------------
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=longa_

# --- Redis -------------------------------------------------------------------
# "phpredis" no Docker (extensão instalada). Sem a extensão (ex.: Windows/Laragon) use "predis".
REDIS_CLIENT=phpredis
# Em Docker: "redis". Fora de Docker: 127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=longa_

# --- Horizon -----------------------------------------------------------------
HORIZON_PREFIX=longa_horizon:

# --- E-mail (Mailpit em desenvolvimento: http://localhost:8025) -------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nao-responder@longa.ao"
MAIL_FROM_NAME="${APP_NAME}"

# --- Reverb (WebSockets) -----------------------------------------------------
# Gere valores próprios: php artisan reverb:install (ou strings aleatórias)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Endereço onde o servidor Reverb escuta (dentro do contentor)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Endereço público usado pelo browser para se ligar
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Web Push (VAPID) --------------------------------------------------------
# Gere um par de chaves (ex.: npx web-push generate-vapid-keys). A chave privada é segredo.
VAPID_SUBJECT=mailto:suporte@longa.ao
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# --- Pagamentos (Fase 3: só o gateway simulado) ------------------------------
# O gateway real será integrado depois da escolha do cliente.
PAYMENT_PROVIDER=mock
# succeeded | failed (telefones a acabar em 0000 falham sempre)
PAYMENT_MOCK_OUTCOME=succeeded

# --- Armazenamento S3 (opcional) ---------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
